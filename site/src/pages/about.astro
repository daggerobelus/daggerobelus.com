---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content, frontmatter } from '../data/about.md';
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <section class="max-w-content mx-auto px-6 md:px-10 py-16 md:py-24">
    <div class="grid md:grid-cols-[1fr_460px] gap-12 md:gap-20 items-start">

      <div class="max-w-2xl">
        <h1 class="display text-4xl md:text-5xl mb-8">{frontmatter.title}</h1>

        <div class="prose prose-lg text-ink/80 space-y-6" style="font-size: 1.125rem; line-height: 1.7;">
          <Content />
        </div>
      </div>

      <figure class="about-portrait order-first md:order-last mx-auto md:mx-0 md:sticky md:top-24">
        <img
          src="/about/sarah.png"
          alt="Portrait of Sarah Bonanno at her writing desk"
          class="w-full h-auto"
          loading="eager"
          decoding="async"
        />
      </figure>

    </div>
  </section>
</BaseLayout>

<style>
  .about-portrait {
    max-width: 460px;
  }
  .about-portrait img {
    border-radius: 2px;
  }
</style>
