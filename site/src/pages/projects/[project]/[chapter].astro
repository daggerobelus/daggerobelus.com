---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allChapters = await getCollection('chapters');
  const allProjects = await getCollection('projects');

  return allChapters.map(chapter => {
    const project = allProjects.find(p => p.slug === chapter.data.project);
    const projectChapters = allChapters
      .filter(ch => ch.data.project === chapter.data.project && (ch.data.status !== 'draft' || ch.slug === chapter.slug))
      .sort((a, b) => a.data.order - b.data.order);

    const currentIndex = projectChapters.findIndex(ch => ch.slug === chapter.slug);
    const prevChapter = currentIndex > 0 ? projectChapters[currentIndex - 1] : null;
    const nextChapter = currentIndex < projectChapters.length - 1 ? projectChapters[currentIndex + 1] : null;

    return {
      params: {
        project: chapter.data.project,
        chapter: chapter.slug,
      },
      props: {
        chapter,
        project,
        prevChapter,
        nextChapter,
        chapterNumber: currentIndex + 1,
        totalChapters: projectChapters.length,
      },
    };
  });
}

const { chapter, project, prevChapter, nextChapter, chapterNumber, totalChapters } = Astro.props;
const { title, description, publishDate, updatedDate } = chapter.data;
const { Content } = await chapter.render();

const projectTitle = project?.data.title || '';
const projectSlug = chapter.data.project;

const displayDate = updatedDate || publishDate;
const dateLabel = updatedDate ? 'Updated' : 'Published';

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<BaseLayout title={`${title} | ${projectTitle}`} description={description} compact={true}>
  <article class="chapter-article">
    <header class="chapter-header">
      <a href={`/projects/${projectSlug}/`} class="chapter-back">
        &larr; {projectTitle}
      </a>

      <div class="chapter-meta">
        <span>Chapter {chapterNumber}{totalChapters > 1 && ` of ${totalChapters}`}</span>
        <span class="chapter-meta-sep">&middot;</span>
        <span>{dateLabel} {formatDate(displayDate)}</span>
      </div>

      <h1 class="chapter-title">{title}</h1>

      <p class="chapter-dek">{description}</p>

      <div class="chapter-rule"></div>
    </header>

    <div class="chapter-body">
      <Content />
    </div>

    <nav class="chapter-nav">
      <div>
        {prevChapter && (
          <a href={`/projects/${projectSlug}/${prevChapter.slug}/`} class="chapter-nav-link">
            <span class="chapter-nav-label">&larr; Previous</span>
            <span class="chapter-nav-title">{prevChapter.data.title}</span>
          </a>
        )}
      </div>
      <div class="text-right">
        {nextChapter && (
          <a href={`/projects/${projectSlug}/${nextChapter.slug}/`} class="chapter-nav-link">
            <span class="chapter-nav-label">Next &rarr;</span>
            <span class="chapter-nav-title">{nextChapter.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style is:global>
  /* ═══════════════════════════════════════════════
     Chapter Grid Layout
     ───────────────────────────────────────────────
     3-column grid: gutter | prose | gutter
     Charts break out to "wide" or "full" tracks.
     No negative margins. Centered by default.
     ═══════════════════════════════════════════════ */

  .chapter-article {
    --prose-width: 75ch;

    display: grid;
    grid-template-columns:
      [full-start]
        1fr
      [prose-start]
        min(var(--prose-width), calc(100% - 3rem))
      [prose-end]
        1fr
      [full-end];

    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  @media (min-width: 768px) {
    .chapter-article {
      padding-top: 5rem;
      padding-bottom: 8rem;
    }
  }

  /* Default: all children sit in the prose column */
  .chapter-article > * {
    grid-column: prose;
    min-width: 0;
  }

  /* Charts break out to full width — they size themselves */
  .chapter-article .chart-wide,
  .chapter-body .chart-wide {
    grid-column: full;
    justify-self: center;
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    overflow: visible;
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  /* Tables need full width, not fit-content */
  .chart-wide:has(table) {
    width: 100%;
    max-width: 65rem;
    overflow-x: visible;
  }

  /* ─── Header ─── */
  .chapter-header {
    margin-bottom: 4rem;
  }

  .chapter-back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink);
    opacity: 0.35;
    text-decoration: none;
    margin-bottom: 2rem;
    transition: opacity 0.2s;
  }

  .chapter-back:hover {
    opacity: 0.7;
  }

  .chapter-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink);
    opacity: 0.4;
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.5rem;
  }

  .chapter-title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .chapter-title {
      font-size: 3.25rem;
    }
  }

  .chapter-dek {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-ink);
    opacity: 0.6;
    margin-bottom: 2.5rem;
  }

  .chapter-rule {
    width: 3rem;
    height: 1px;
    background: var(--color-ink);
    opacity: 0.2;
  }

  /* ─── Body / Prose ─── */
  .chapter-body {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: full;
    color: var(--color-ink);
  }

  .chapter-body > * {
    grid-column: prose;
    min-width: 0;
  }

  .chapter-body > .chart-wide {
    grid-column: full;
  }

  .chapter-body p {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.85;
    margin-bottom: 1.5rem;
  }

  /* Drop cap on first paragraph */
  .chapter-body > p:first-child::first-letter {
    font-family: var(--font-serif);
    float: left;
    font-size: 4rem;
    line-height: 0.75;
    padding-right: 0.5rem;
    padding-top: 0.35rem;
    font-weight: 400;
    color: var(--color-ink);
  }

  /* ─── Headings ─── */
  .chapter-body h2 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.3;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(18, 18, 18, 0.1);
  }

  .chapter-body h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    font-style: italic;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  /* ─── Links ─── */
  .chapter-body a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: rgba(18, 18, 18, 0.3);
    text-underline-offset: 0.15em;
    transition: text-decoration-color 0.2s;
  }

  .chapter-body a:hover {
    text-decoration-color: var(--color-ink);
  }

  /* ─── Lists ─── */
  .chapter-body ul {
    list-style: none;
    padding-left: 0;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
  }

  .chapter-body ul li::marker {
    content: none;
  }

  .chapter-body li {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: 1.75rem;
    padding-left: 1.25rem;
    border-left: 2px solid rgba(18, 18, 18, 0.12);
  }

  .chapter-body li strong {
    font-weight: 600;
  }

  .chapter-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .chapter-body strong {
    font-weight: 600;
  }

  /* ─── Navigation ─── */
  .chapter-nav {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(18, 18, 18, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: start;
  }

  .chapter-nav-link {
    text-decoration: none;
    color: var(--color-ink);
  }

  .chapter-nav-link:hover .chapter-nav-title {
    opacity: 0.6;
  }

  .chapter-nav-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.4;
    margin-bottom: 0.35rem;
  }

  .chapter-nav-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    transition: opacity 0.2s;
  }
</style>
