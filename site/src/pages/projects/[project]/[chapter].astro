---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allChapters = await getCollection('chapters');
  const allProjects = await getCollection('projects');

  return allChapters.map(chapter => {
    const project = allProjects.find(p => p.slug === chapter.data.project);
    const projectChapters = allChapters
      .filter(ch => ch.data.project === chapter.data.project && (ch.data.status !== 'draft' || ch.slug === chapter.slug))
      .sort((a, b) => a.data.order - b.data.order);

    const currentIndex = projectChapters.findIndex(ch => ch.slug === chapter.slug);
    const prevChapter = currentIndex > 0 ? projectChapters[currentIndex - 1] : null;
    const nextChapter = currentIndex < projectChapters.length - 1 ? projectChapters[currentIndex + 1] : null;

    return {
      params: {
        project: chapter.data.project,
        chapter: chapter.slug,
      },
      props: {
        chapter,
        project,
        prevChapter,
        nextChapter,
        chapterNumber: currentIndex + 1,
        totalChapters: projectChapters.length,
      },
    };
  });
}

const { chapter, project, prevChapter, nextChapter, chapterNumber, totalChapters } = Astro.props;
const { title, description, publishDate, updatedDate } = chapter.data;
const { Content } = await chapter.render();

const projectTitle = project?.data.title || '';
const projectSlug = chapter.data.project;

const displayDate = updatedDate || publishDate;
const dateLabel = updatedDate ? 'Updated' : 'Published';

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<BaseLayout title={`${title} | ${projectTitle}`} description={description} compact={true}>
  <article class="chapter-article">
    <header class="chapter-header">
      <a href={`/projects/${projectSlug}/`} class="chapter-back">
        &larr; {projectTitle}
      </a>

      <div class="chapter-meta">
        <span>Chapter {chapterNumber}{totalChapters > 1 && ` of ${totalChapters}`}</span>
        <span class="chapter-meta-sep">&middot;</span>
        <span>{dateLabel} {formatDate(displayDate)}</span>
      </div>

      <h1 class="chapter-title">{title}</h1>

      <p class="chapter-dek">{description}</p>

      <div class="chapter-rule"></div>
    </header>

    <div class="chapter-body">
      <Content />
    </div>

    <nav class="chapter-nav">
      <div>
        {prevChapter && (
          <a href={`/projects/${projectSlug}/${prevChapter.slug}/`} class="chapter-nav-link">
            <span class="chapter-nav-label">&larr; Previous</span>
            <span class="chapter-nav-title">{prevChapter.data.title}</span>
          </a>
        )}
      </div>
      <div class="text-right">
        {nextChapter && (
          <a href={`/projects/${projectSlug}/${nextChapter.slug}/`} class="chapter-nav-link">
            <span class="chapter-nav-label">Next &rarr;</span>
            <span class="chapter-nav-title">{nextChapter.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style is:global>
  /* ═══════════════════════════════════════════════
     Chapter Grid Layout
     ───────────────────────────────────────────────
     3-column grid: gutter | prose | gutter
     Charts break out to "wide" or "full" tracks.
     No negative margins. Centered by default.
     ═══════════════════════════════════════════════ */

  .chapter-article {
    /* 42rem ≈ 672px, gives ~72–75ch at the paragraph's 18px serif.
       Using rem (not ch) decouples from the context-inheritance trap
       where ch is evaluated against the parent's font-size. */
    --prose-width: 42rem;

    display: grid;
    grid-template-columns:
      [full-start]
        1fr
      [prose-start]
        min(var(--prose-width), calc(100% - 3rem))
      [prose-end]
        1fr
      [full-end];

    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  @media (min-width: 768px) {
    .chapter-article {
      padding-top: 5rem;
      padding-bottom: 8rem;
    }
  }

  /* Default: all children sit in the prose column */
  .chapter-article > * {
    grid-column: prose;
    min-width: 0;
  }

  /* Figure plates — one consistent width tier beyond prose.
     Auto-numbered FIG. N label signals "this is a figure, not misaligned prose." */
  .chapter-body {
    counter-reset: fig;
  }

  .chapter-article .chart-wide,
  .chapter-body .chart-wide {
    grid-column: full;
    justify-self: center;
    width: 100%;
    max-width: min(60rem, 100% - 2rem);
    min-width: 0;
    overflow: visible;
    counter-increment: fig;
    position: relative;
    margin-top: 4.5rem;
    margin-bottom: 4rem;
    padding: 2.5rem 2rem 1.75rem;
    /* Tighter horizontal padding on mobile so small-viewport content
       doesn't get squeezed. */
    @media (max-width: 767px) {
      padding: 2rem 1rem 1.5rem;
    }
    /* Very subtle vertical gold wash top and bottom + inset top shadow —
       ties the two hairlines into a defined surface without reading as
       a heavy fill. */
    background: linear-gradient(
      to bottom,
      #d3a44e0f,
      transparent 50px,
      transparent calc(100% - 50px),
      #d3a44e0f
    );
    box-shadow: 0 7px 5px -5px rgba(0, 0, 0, 0.04) inset;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 65%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-gold) 40%, transparent);
  }

  /* Reorder the figure so the caption (with FIG N prefix) sits above the
     graphic — reader sees "FIG 05 — what this is" before the visual. */
  .chart-wide figure {
    display: flex;
    flex-direction: column;
  }
  .chart-wide figcaption {
    order: -1;
  }

  /* Fallback: when a chart component renders no figcaption, still label
     the plate so every interjection is identified. */
  .chart-wide:not(:has(figcaption))::before {
    content: "Fig. " counter(fig, decimal-leading-zero);
    display: block;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1.5rem;
  }

  /* Asterism-in-circle ornament sits on the top hairline, echoing the
     homepage Divider (mark-with-flanking-lines). */
  .chapter-article .chart-wide::after,
  .chapter-body .chart-wide::after {
    content: "⁂";
    position: absolute;
    top: -1.125rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-gold) 65%, transparent);
    background: var(--color-ivory);
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1;
    letter-spacing: 0;
    padding-bottom: 0.12em;
  }

  /* Figure captions — italic serif with "FIG. N —" small-caps prefix,
     sitting at the top of the plate above the graphic */
  .chart-wide figcaption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-ink) 72%, var(--color-ivory));
    text-align: left;
    max-width: 100%;
    margin: 0 0 1.5rem;
    padding: 0;
    letter-spacing: normal;
    font-weight: 400;
    text-transform: none;
  }
  .chart-wide figcaption::before {
    content: "Fig. " counter(fig, decimal-leading-zero) " — ";
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 500;
    font-size: 0.78em;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-right: 0.15em;
  }

  /* Tables inside figures still get the full plate width */
  .chart-wide:has(table) {
    max-width: min(60rem, 100% - 2rem);
  }

  /* Avoid double gold hairlines when a header (or another figure) sits
     immediately after a figure plate — drop the second line. */
  .chapter-body .chart-wide + h2 {
    border-top: none;
    padding-top: 0;
    margin-top: 2.5rem;
  }
  .chapter-body .chart-wide + .chart-wide {
    border-top: none;
    margin-top: 0;
    padding-top: 1rem;
  }

  /* ─── Header ─── */
  .chapter-header {
    margin-bottom: 4rem;
  }

  .chapter-back {
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink);
    opacity: 0.55;
    text-decoration: none;
    margin-bottom: 2rem;
    transition: opacity 0.2s, color 0.2s;
  }

  .chapter-back:hover {
    opacity: 1;
    color: var(--color-gold);
  }

  .chapter-meta {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink);
    opacity: 0.55;
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.5rem;
  }

  .chapter-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .chapter-title {
      font-size: 3.25rem;
    }
  }

  .chapter-dek {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink) 75%, var(--color-ivory));
    margin-bottom: 2.5rem;
  }

  .chapter-rule {
    width: 3rem;
    height: 1px;
    background: color-mix(in srgb, var(--color-gold) 60%, transparent);
  }

  /* ─── Body / Prose ─── */
  .chapter-body {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: full;
    color: var(--color-ink);
  }

  .chapter-body > * {
    grid-column: prose;
    min-width: 0;
  }

  .chapter-body > .chart-wide {
    grid-column: full;
  }

  .chapter-body p {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.85;
    margin-bottom: 1.5rem;
  }

  /* Drop cap on first paragraph */
  .chapter-body > p:first-child::first-letter {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--color-ink);
    float: left;
    font-size: 3.6em;
    line-height: 0.82;
    margin: 0.04em 0.52em 0 -0.02em;
    padding-right: 0.04em;
  }
  @supports (initial-letter: 3) or (-webkit-initial-letter: 3) {
    .chapter-body > p:first-child::first-letter {
      float: none;
      font-size: inherit;
      line-height: inherit;
      margin: 0 0.54em 0 0;
      padding: 0;
      -webkit-initial-letter: 3;
      initial-letter: 3;
    }
  }

  /* ─── Headings ─── */
  .chapter-body h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.005em;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 35%, transparent);
    text-wrap: balance;
  }

  .chapter-body h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    font-style: italic;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  /* ─── Links ─── */
  .chapter-body a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--color-gold) 55%, transparent);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s, color 0.2s;
  }

  .chapter-body a:hover {
    color: color-mix(in srgb, var(--color-gold) 70%, var(--color-ink));
    text-decoration-color: var(--color-gold);
  }

  /* ─── Lists ─── */
  .chapter-body ul {
    list-style: none;
    padding-left: 0;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
  }

  .chapter-body ul li::marker {
    content: none;
  }

  .chapter-body li {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: 1.75rem;
    padding-left: 1.25rem;
    border-left: 2px solid rgba(18, 18, 18, 0.12);
  }

  .chapter-body li strong {
    font-weight: 600;
  }

  .chapter-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .chapter-body strong {
    font-weight: 600;
  }

  /* ─── Navigation ─── */
  .chapter-nav {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 35%, transparent);
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 2rem;
  }

  .chapter-nav-link {
    text-decoration: none;
    color: var(--color-ink);
  }

  .chapter-nav-link:hover .chapter-nav-title {
    color: color-mix(in srgb, var(--color-gold) 70%, var(--color-ink));
  }

  .chapter-nav-label {
    display: block;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-gold);
    opacity: 0.85;
    margin-bottom: 0.5rem;
  }

  .chapter-nav-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.1rem;
    line-height: 1.2;
    transition: color 0.2s;
  }
</style>
