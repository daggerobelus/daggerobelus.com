---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allChapters = await getCollection('chapters');
  const allProjects = await getCollection('projects');

  return allChapters.map(chapter => {
    const project = allProjects.find(p => p.slug === chapter.data.project);
    const projectChapters = allChapters
      .filter(ch => ch.data.project === chapter.data.project && ch.data.status !== 'draft')
      .sort((a, b) => a.data.order - b.data.order);

    const currentIndex = projectChapters.findIndex(ch => ch.slug === chapter.slug);
    const prevChapter = currentIndex > 0 ? projectChapters[currentIndex - 1] : null;
    const nextChapter = currentIndex < projectChapters.length - 1 ? projectChapters[currentIndex + 1] : null;

    return {
      params: {
        project: chapter.data.project,
        chapter: chapter.slug,
      },
      props: {
        chapter,
        project,
        prevChapter,
        nextChapter,
        chapterNumber: currentIndex + 1,
        totalChapters: projectChapters.length,
      },
    };
  });
}

const { chapter, project, prevChapter, nextChapter, chapterNumber, totalChapters } = Astro.props;
const { title, description, publishDate, updatedDate } = chapter.data;
const { Content } = await chapter.render();

const projectTitle = project?.data.title || '';
const projectSlug = chapter.data.project;

const displayDate = updatedDate || publishDate;
const dateLabel = updatedDate ? 'Updated' : 'Published';

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<BaseLayout title={`${title} | ${projectTitle}`} description={description}>
  <article class="max-w-content mx-auto px-6 md:px-10 py-16 md:py-24">
    <header class="max-w-3xl mb-12">
      <div class="mb-6">
        <a
          href={`/projects/${projectSlug}/`}
          class="text-xs font-mono uppercase tracking-wider text-ink/40 hover:text-ink/70 transition-colors"
        >
          &larr; {projectTitle}
        </a>
      </div>

      <div class="text-sm font-mono text-ink/40 mb-4">
        Chapter {chapterNumber} of {totalChapters}
      </div>

      <h1 class="text-4xl md:text-5xl font-serif leading-tight mb-6">
        {title}
      </h1>

      <p class="text-xl text-ink/70 leading-relaxed mb-6">
        {description}
      </p>

      <div class="text-sm text-ink/50 font-mono">
        <span>{dateLabel} {formatDate(displayDate)}</span>
      </div>
    </header>

    <div class="prose prose-lg max-w-3xl prose-headings:font-serif prose-headings:font-normal prose-a:underline prose-a:decoration-ink/30 hover:prose-a:decoration-ink">
      <Content />
    </div>

    <nav class="max-w-3xl mt-16 pt-8 border-t border-ink/10 flex justify-between items-start">
      <div>
        {prevChapter && (
          <a
            href={`/projects/${projectSlug}/${prevChapter.slug}/`}
            class="group"
          >
            <span class="text-xs font-mono text-ink/40 block mb-1">&larr; Previous</span>
            <span class="font-serif group-hover:opacity-70 transition-opacity">
              {prevChapter.data.title}
            </span>
          </a>
        )}
      </div>
      <div class="text-right">
        {nextChapter && (
          <a
            href={`/projects/${projectSlug}/${nextChapter.slug}/`}
            class="group"
          >
            <span class="text-xs font-mono text-ink/40 block mb-1">Next &rarr;</span>
            <span class="font-serif group-hover:opacity-70 transition-opacity">
              {nextChapter.data.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style is:global>
  .prose {
    --tw-prose-body: var(--color-ink);
    --tw-prose-headings: var(--color-ink);
    --tw-prose-links: var(--color-ink);
    color: var(--tw-prose-body);
  }

  .prose h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.75rem;
  }

  .prose h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose strong {
    font-weight: 600;
  }
</style>
