---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const allChapters = await getCollection('chapters');

  return projects.map(project => {
    const projectChapters = allChapters
      .filter(ch => ch.data.project === project.slug && ch.data.status !== 'draft')
      .sort((a, b) => a.data.order - b.data.order);

    return {
      params: { slug: project.slug },
      props: { project, chapters: projectChapters },
    };
  });
}

const { project, chapters } = Astro.props;
const { title, description, publishDate, updatedDate, image, imageAlt, status, tags } = project.data;
const { Content } = await project.render();

// Consider the prose body empty when only MDX/HTML/JSX comments and whitespace remain
const hasProseContent = project.body
  ? project.body
      .replace(/\{\/\*[\s\S]*?\*\/\}/g, '')  // JSX/MDX comments
      .replace(/<!--[\s\S]*?-->/g, '')        // HTML comments
      .trim().length > 0
  : false;

const displayDate = updatedDate || publishDate;
const dateLabel = updatedDate ? 'Updated' : 'Published';
const eyebrow = status === 'in-progress' ? 'In Progress' : 'Featured';

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<BaseLayout title={title} description={description} image={image} compact={true}>
  <article class="max-w-content mx-auto px-6 md:px-10 pt-10 md:pt-14 pb-20">

    <header class="max-w-3xl">
      <div class="font-ui text-gold mb-6">{eyebrow}</div>

      <h1 class="display text-4xl md:text-5xl text-ink">
        {title}
      </h1>

      <p class="prose-editorial mt-5 text-ink/75">
        {description}
      </p>

      <div class="mt-6 flex items-baseline gap-3 flex-wrap">
        <span class="font-ui text-ink/55">
          {dateLabel} {formatDate(displayDate)}
        </span>
        {tags && tags.length > 0 && (
          <>
            <span class="glyph not-italic text-[0.8rem] leading-none" aria-hidden="true">†</span>
            <div class="flex items-baseline gap-3 flex-wrap">
              {tags.slice(0, 2).map((tag, i) => (
                <>
                  {i > 0 && <span class="font-ui text-gold/40" aria-hidden="true">·</span>}
                  <span class="font-ui text-gold">{tag}</span>
                </>
              ))}
            </div>
          </>
        )}
      </div>
    </header>

    {chapters.length > 0 && (
      <>
        <Divider size="sm" />

        <section class="max-w-3xl">
          <h2 class="display text-2xl md:text-3xl text-ink mb-10">
            Chapters
          </h2>

          <ol class="flex flex-col gap-8 md:gap-10">
            {chapters.map((chapter, i) => (
              <li class="chapter-row">
                <a href={`/projects/${project.slug}/${chapter.slug}/`} class="chapter-link">
                  <span class="chapter-number">
                    {(i + 1).toString().padStart(2, '0')}
                  </span>
                  <div class="chapter-body">
                    <h3 class="chapter-title display text-xl md:text-2xl text-ink">
                      {chapter.data.title}
                      <span class="annotated-mark" aria-hidden="true">†</span>
                    </h3>
                    <p class="chapter-desc mt-2 text-ink/70" style="font-family: var(--font-serif);">
                      {chapter.data.description}
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </section>
      </>
    )}

    {/* Long-form overview/prose, if the project provides it */}
    {hasProseContent && (
      <>
        <Divider size="sm" />

        <section
          class="max-w-3xl prose prose-lg"
          style="font-family: var(--font-serif);"
        >
          <Content />
        </section>
      </>
    )}

  </article>
</BaseLayout>

<style is:global>
  #page a.chapter-link {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    text-decoration: none;
    color: inherit;
  }
  .chapter-number {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--color-gold);
    font-feature-settings: "onum";
    text-align: right;
    letter-spacing: -0.02em;
    transition: opacity 200ms ease;
    opacity: 0.85;
  }
  #page a.chapter-link:hover .chapter-number {
    opacity: 1;
  }
  .chapter-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: transparent;
    text-underline-offset: 0.12em;
    transition: text-decoration-color 200ms ease;
  }
  #page a.chapter-link:hover .chapter-title {
    text-decoration-color: color-mix(in srgb, var(--color-gold) 55%, transparent);
  }
  .chapter-title .annotated-mark {
    margin-left: 0.18em;
    color: var(--color-gold);
    font-style: italic;
    font-size: 0.72em;
    vertical-align: 0.1em;
    opacity: 0.55;
    transition: opacity 200ms ease;
  }
  #page a.chapter-link:hover .chapter-title .annotated-mark {
    opacity: 1;
  }

  /* Prose body (when a project has actual written content) */
  .prose {
    --tw-prose-body: var(--color-ink);
    --tw-prose-headings: var(--color-ink);
    --tw-prose-links: var(--color-gold);
    color: var(--tw-prose-body);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .prose h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose p {
    margin-bottom: 1.25rem;
  }
  .prose strong {
    font-weight: 600;
  }
</style>
