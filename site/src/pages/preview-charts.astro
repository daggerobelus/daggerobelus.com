---
import BaseLayout from '../layouts/BaseLayout.astro';
import CERProgressionChart from '../components/charts/CERProgressionChart.astro';
import BlindVsNonBlindChart from '../components/charts/BlindVsNonBlindChart.astro';
import MethodTimelineChart from '../components/charts/MethodTimelineChart.astro';
import ErrorBreakdownChart from '../components/charts/ErrorBreakdownChart.astro';
import ManuscriptDifficultyChart from '../components/charts/ManuscriptDifficultyChart.astro';
import HallucinationExplorer from '../components/charts/HallucinationExplorer.astro';
import CERResultsTable from '../components/charts/CERResultsTable.astro';
import TryReadingThis from '../components/charts/TryReadingThis.astro';
import AlphabetViewer from '../components/charts/AlphabetViewer.astro';
import WordDiffViewer from '../components/charts/WordDiffViewer.astro';
import GenerationEffectChart from '../components/charts/GenerationEffectChart.astro';
import StackingFailureChart from '../components/charts/StackingFailureChart.astro';
---

<BaseLayout title="Chart Preview" description="Preview of blog post visualizations">
  <article class="max-w-content mx-auto px-6 md:px-10 py-16 md:py-24">
    <h1 class="text-4xl font-serif mb-4">Chart Preview</h1>
    <p class="text-ink/60 font-mono text-sm mb-16">Interactive visualizations organized by chapter</p>

    <!-- ============================================ -->
    <!-- CHAPTER 1: Early Exploration (Runs 1-8)      -->
    <!-- ============================================ -->

    <div class="mb-8 pb-4 border-b border-ink/10">
      <h2 class="text-3xl font-serif mb-1">Chapter 1: Early Exploration</h2>
      <p class="text-ink/50 font-mono text-sm">Runs 1–8 — Can Claude learn to read manuscripts?</p>
    </div>

    <section class="mb-20">
      <h3 class="text-2xl font-serif mb-2">1.1 Manuscript Difficulty</h3>
      <p class="text-ink/70 mb-6">The five test manuscripts, ranked by difficulty with actual images.</p>
      <ManuscriptDifficultyChart />
    </section>

    <section class="mb-20">
      <h3 class="text-2xl font-serif mb-2">1.2 Try Transcribing This</h3>
      <p class="text-ink/70 mb-6">Can you read early modern handwriting? Type your attempt and compare your score to the AI's.</p>
      <TryReadingThis />
    </section>

    <section class="mb-20">
      <h3 class="text-2xl font-serif mb-2">1.3 What Worked vs. What Didn't</h3>
      <p class="text-ink/70 mb-6">A timeline of methodological experiments.</p>
      <MethodTimelineChart />
    </section>

    <section class="mb-20">
      <h3 class="text-2xl font-serif mb-2">1.4 CER Progression</h3>
      <p class="text-ink/70 mb-6">Henslow MS688 — the clearest success story — across eight runs.</p>
      <CERProgressionChart />
      <CERResultsTable />
    </section>

    <section class="mb-20">
      <h3 class="text-2xl font-serif mb-2">1.5 Non-Blind vs. Blind</h3>
      <p class="text-ink/70 mb-6">The reality check: how much non-blind testing inflated results.</p>
      <BlindVsNonBlindChart />
    </section>

    <section class="mb-20">
      <h3 class="text-2xl font-serif mb-2">1.6 Error Type Breakdown</h3>
      <p class="text-ink/70 mb-6">What kinds of mistakes the AI makes.</p>
      <ErrorBreakdownChart />
    </section>

    <section class="mb-20">
      <h3 class="text-2xl font-serif mb-2">1.7 Hallucination Explorer</h3>
      <p class="text-ink/70 mb-6">Compare what the AI fabricated vs. what the manuscript actually says.</p>
      <HallucinationExplorer />
    </section>

    <section class="mb-20">
      <h3 class="text-2xl font-serif mb-2">1.8 Word-Level Diff</h3>
      <p class="text-ink/70 mb-6">The AI's best transcription vs. the reference — every error highlighted and explained.</p>
      <WordDiffViewer />
    </section>

    <section class="mb-20">
      <h3 class="text-2xl font-serif mb-2">1.9 The Alphabet the Agent Built</h3>
      <p class="text-ink/70 mb-6">What the AI learned by studying the hand before transcribing.</p>
      <AlphabetViewer />
    </section>

    <!-- ============================================ -->
    <!-- CHAPTER 2: How Agents Learn (Runs 9-13)      -->
    <!-- ============================================ -->

    <div class="mt-32 mb-8 pb-4 border-b border-ink/10">
      <h2 class="text-3xl font-serif mb-1">Chapter 2: How Agents Learn</h2>
      <p class="text-ink/50 font-mono text-sm">Runs 9–13 — Learning, transfer, and the limits of stacking</p>
    </div>

    <section class="mb-20">
      <h3 class="text-2xl font-serif mb-2">2.1 Generation Effect</h3>
      <p class="text-ink/70 mb-6">Same-agent guides produce tight consistency; different-agent guides scatter widely.</p>
      <GenerationEffectChart />
    </section>

    <section class="mb-20">
      <h3 class="text-2xl font-serif mb-2">2.2 Stacking Failure</h3>
      <p class="text-ink/70 mb-6">What happens when you combine every intervention at once.</p>
      <StackingFailureChart />
    </section>

  </article>
</BaseLayout>
