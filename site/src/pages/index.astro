---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Divider from '../components/Divider.astro';

const allProjects = await getCollection('projects', ({ data }) => {
  return data.status !== 'draft';
});

const sortedProjects = allProjects.sort((a, b) =>
  b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const featuredProject = sortedProjects.find(p => p.data.featured) || sortedProjects[0];
const otherProjects = sortedProjects.filter(p => p.slug !== featuredProject?.slug);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout>
  <section class="max-w-content mx-auto px-6 md:px-10 pt-14 md:pt-20 pb-12">

    {featuredProject && (
      <div class="grid md:grid-cols-[1.05fr_1fr] gap-10 md:gap-20 items-center">
        <div class="flex flex-col">
          <div class:list={[
            'font-ui mb-7 flex items-center gap-2',
            featuredProject.data.status === 'in-progress' ? 'text-research' : 'text-gold'
          ]}>
            <span>{featuredProject.data.status === 'in-progress' ? 'In Progress' : 'Featured'}</span>
          </div>

          <a href={`/projects/${featuredProject.slug}/`} class="rise rise-2 title-link self-start">
            <h1 class="display text-5xl md:text-7xl text-ink">
              {featuredProject.data.title}
            </h1>
          </a>

          <p class="rise rise-3 drop-cap prose-editorial mt-8 max-w-xl">
            {featuredProject.data.description}
          </p>

          <div class="rise rise-4 mt-9 flex items-baseline gap-3 flex-wrap">
            <time
              datetime={featuredProject.data.publishDate.toISOString()}
              class="font-ui text-ink/55"
            >
              {formatDate(featuredProject.data.publishDate)}
            </time>
            {featuredProject.data.tags && featuredProject.data.tags.length > 0 && (
              <>
                <span class="glyph not-italic text-[0.8rem] leading-none" aria-hidden="true">†</span>
                <div class="flex items-baseline gap-3 flex-wrap">
                  {featuredProject.data.tags.slice(0, 2).map((tag, i) => (
                    <>
                      {i > 0 && <span class="font-ui text-gold/40" aria-hidden="true">·</span>}
                      <span class="font-ui text-gold">{tag}</span>
                    </>
                  ))}
                </div>
              </>
            )}
          </div>

          <a
            href={`/projects/${featuredProject.slug}/`}
            class="rise rise-5 mt-7 annotated-link self-start"
            style="font-size: 1.1rem;"
          >
            <span class="annotated-text">Read more</span><span class="annotated-mark" aria-hidden="true">†</span>
          </a>
        </div>

        {featuredProject.data.image && (
          <a href={`/projects/${featuredProject.slug}/`} class="rise rise-3 block no-underline self-start">
            <figure class="hero-figure">
              <img
                src={featuredProject.data.image}
                alt={featuredProject.data.imageAlt || featuredProject.data.title}
                class="w-full h-auto object-contain"
                loading="eager"
                decoding="async"
              />
            </figure>
          </a>
        )}
      </div>
    )}

    {otherProjects.length > 0 && (
      <>
        <Divider size="md" />

        <div class="mt-4">
          <div class="flex items-baseline justify-between gap-6 mb-12">
            <h2 class="display text-3xl md:text-4xl text-ink">
              Recent Projects
            </h2>
            {sortedProjects.length > 4 && (
              <a
                href="/"
                class="shrink-0 annotated-link"
                style="font-size: 1rem;"
              >
                <span class="annotated-text">View all projects</span><span class="annotated-mark" aria-hidden="true">†</span>
              </a>
            )}
          </div>

          <div class="grid gap-16 md:gap-20">
            {otherProjects.map(project => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      </>
    )}

    {sortedProjects.length === 0 && (
      <div class="text-center py-20 text-ink/50">
        <p>No projects yet. Check back soon.</p>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .hero-figure {
    position: relative;
    padding: 1.25rem;
  }
  .hero-figure img {
    border-radius: 2px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }
  .hero-figure::before,
  .hero-figure::after {
    content: "";
    position: absolute;
    background: color-mix(in srgb, var(--color-gold) 55%, transparent);
  }
  .hero-figure::before {
    top: 0; left: 0; width: 28px; height: 1px;
    box-shadow: 0 27px 0 color-mix(in srgb, var(--color-gold) 55%, transparent);
  }
  .hero-figure::after {
    top: 0; left: 0; width: 1px; height: 28px;
    box-shadow: 27px 0 0 color-mix(in srgb, var(--color-gold) 55%, transparent);
  }
</style>

