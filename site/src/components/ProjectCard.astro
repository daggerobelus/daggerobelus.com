---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, description, publishDate, updatedDate, image, imageAlt, status, tags } = project.data;

const displayDate = updatedDate || publishDate;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<article class:list={[
  'group',
  featured ? 'md:grid md:grid-cols-2 md:gap-12 items-start' : image ? 'md:grid md:grid-cols-[320px_1fr] md:gap-10 items-start' : ''
]}>
  {image && (
    <a
      href={`/projects/${project.slug}/`}
      class="card-image block overflow-hidden mb-6 md:mb-0 bg-ivory"
    >
      <Image
        src={image}
        alt={imageAlt || title}
        widths={[320, 640, 960]}
        sizes="(min-width: 768px) 320px, 90vw"
        loading="eager"
        class:list={[
          'w-full transition-transform duration-500 group-hover:scale-[1.02]',
          featured ? 'object-contain' : 'object-cover aspect-[4/3]'
        ]}
      />
    </a>
  )}

  <div class="flex flex-col">
    {status === 'in-progress' && (
      <span class="font-ui text-gold mb-3">
        In Progress
      </span>
    )}

    <a href={`/projects/${project.slug}/`} class="title-link">
      <h2
        class:list={[
          'display leading-[1.1]',
          featured ? 'text-4xl md:text-5xl' : 'text-2xl md:text-3xl'
        ]}
      >
        {title}
      </h2>
    </a>

    <p class="mt-4 text-ink/75 leading-relaxed line-clamp-3" style="font-family: var(--font-serif);">
      {description}
    </p>

    <div class="mt-5 flex items-center gap-3 flex-wrap">
      <time datetime={displayDate.toISOString()} class="font-ui text-ink/55">
        {formatDate(displayDate)}
      </time>

      {tags && tags.length > 0 && (
        <>
          <span class="text-ink/25">·</span>
          <div class="flex gap-3 flex-wrap">
            {tags.slice(0, 2).map((tag, i) => (
              <>
                {i > 0 && <span class="font-ui text-gold/40" aria-hidden="true">·</span>}
                <span class="font-ui text-gold">{tag}</span>
              </>
            ))}
          </div>
        </>
      )}
    </div>

    <a
      href={`/projects/${project.slug}/`}
      class="mt-5 annotated-link self-start"
      style="font-size: 1rem;"
    >
      <span class="annotated-text">Read more</span><span class="annotated-mark" aria-hidden="true">†</span>
    </a>
  </div>
</article>

<style>
  article :global(a) {
    text-decoration: none !important;
  }
  .card-image {
    border-radius: 2px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
</style>
