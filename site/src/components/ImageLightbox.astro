---
/**
 * Global image lightbox with pan & zoom.
 *
 *   <img data-zoom-src="/full.jpg" data-zoom-caption="My caption" />
 *   <a data-lightbox href="/full.jpg"><img src="/thumb.jpg" /></a>
 *
 * Click opens fullscreen overlay. Scroll to zoom, drag to pan.
 * Escape / click-background / × closes. Double-click resets zoom.
 */
---

<div id="lightbox-overlay" aria-hidden="true">
  <button id="lightbox-close" aria-label="Close">&times;</button>
  <div id="lightbox-viewport">
    <img id="lightbox-img" alt="" draggable="false" />
  </div>
  <figcaption id="lightbox-caption"></figcaption>
  <div id="lightbox-zoom-hint">Scroll to zoom · Drag to pan</div>
</div>

<style is:global>
  /* ─── Zoomable cursor hint ─── */
  [data-zoom-src],
  [data-lightbox] img {
    cursor: zoom-in;
  }

  /* ─── Overlay ─── */
  #lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.92);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  #lightbox-overlay[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  /* ─── Close button ─── */
  #lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem;
    transition: color 0.15s;
    z-index: 1;
  }

  #lightbox-close:hover {
    color: #fff;
  }

  /* ─── Viewport (pan/zoom container) ─── */
  #lightbox-viewport {
    overflow: hidden;
    width: 90vw;
    height: calc(90vh - 3rem);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    touch-action: none;
  }

  #lightbox-viewport.dragging {
    cursor: grabbing;
  }

  #lightbox-img {
    transform-origin: 0 0;
    max-width: none;
    max-height: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    user-select: none;
    -webkit-user-drag: none;
  }

  #lightbox-img.loaded {
    opacity: 1;
  }

  /* ─── Caption ─── */
  #lightbox-caption {
    color: rgba(255, 255, 255, 0.6);
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-align: center;
    margin-top: 0.75rem;
    max-width: 40rem;
    line-height: 1.5;
    flex-shrink: 0;
  }

  #lightbox-caption:empty {
    display: none;
  }

  /* ─── Zoom hint ─── */
  #lightbox-zoom-hint {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.35);
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  #lightbox-overlay.zoomed #lightbox-zoom-hint {
    opacity: 0;
  }
</style>

<script>
  const overlay = document.getElementById('lightbox-overlay')!;
  const viewport = document.getElementById('lightbox-viewport')!;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const caption = document.getElementById('lightbox-caption')!;
  const closeBtn = document.getElementById('lightbox-close')!;

  // Transform state
  let scale = 1;
  let tx = 0;
  let ty = 0;
  let fitScale = 1; // scale that fits image to viewport

  function applyTransform() {
    // img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    overlay.classList.toggle('zoomed', scale > fitScale + 0.01);
  }

  function fitToViewport() {
    const vw = viewport.clientWidth;
    const vh = viewport.clientHeight;
    const iw = img.naturalWidth;
    const ih = img.naturalHeight;
    if (!iw || !ih) return;

    fitScale = Math.min(vw / iw, vh / ih, 1); // never upscale
    scale = fitScale;
    // Center the image
    tx = (vw - iw * scale) / 2;
    ty = (vh - ih * scale) / 2;
    applyTransform();
  }

  function open(src: string, captionText: string) {
    img.classList.remove('loaded');
    img.src = src;
    img.onload = () => {
      fitToViewport();
      img.classList.add('loaded');
    };
    caption.textContent = captionText;
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    overlay.setAttribute('aria-hidden', 'true');
    overlay.classList.remove('zoomed');
    document.body.style.overflow = '';
    setTimeout(() => { img.src = ''; scale = 1; tx = 0; ty = 0; }, 250);
  }

  // ─── Wheel zoom (toward cursor) ───
  viewport.addEventListener('wheel', (e) => {
    e.preventDefault();
    const rect = viewport.getBoundingClientRect();
    const mx = e.clientX - rect.left; // mouse pos in viewport
    const my = e.clientY - rect.top;

    const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
    const newScale = Math.max(fitScale * 0.5, Math.min(scale * factor, 15));

    // Zoom toward cursor: adjust translation so point under cursor stays fixed
    tx = mx - (mx - tx) * (newScale / scale);
    ty = my - (my - ty) * (newScale / scale);
    scale = newScale;
    applyTransform();
  }, { passive: false });

  // ─── Drag to pan ───
  let dragging = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let dragStartTx = 0;
  let dragStartTy = 0;

  viewport.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    dragging = true;
    dragStartX = e.clientX;
    dragStartY = e.clientY;
    dragStartTx = tx;
    dragStartTy = ty;
    viewport.classList.add('dragging');
    viewport.setPointerCapture(e.pointerId);
  });

  viewport.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    tx = dragStartTx + (e.clientX - dragStartX);
    ty = dragStartTy + (e.clientY - dragStartY);
    applyTransform();
  });

  viewport.addEventListener('pointerup', () => {
    dragging = false;
    viewport.classList.remove('dragging');
  });

  // ─── Double-click to reset ───
  viewport.addEventListener('dblclick', () => {
    fitToViewport();
  });

  // ─── Pinch zoom (touch) ───
  let lastPinchDist = 0;

  viewport.addEventListener('touchstart', (e) => {
    if (e.touches.length === 2) {
      const dx = e.touches[0].clientX - e.touches[1].clientX;
      const dy = e.touches[0].clientY - e.touches[1].clientY;
      lastPinchDist = Math.hypot(dx, dy);
    }
  }, { passive: true });

  viewport.addEventListener('touchmove', (e) => {
    if (e.touches.length !== 2) return;
    e.preventDefault();
    const dx = e.touches[0].clientX - e.touches[1].clientX;
    const dy = e.touches[0].clientY - e.touches[1].clientY;
    const dist = Math.hypot(dx, dy);

    if (lastPinchDist > 0) {
      const rect = viewport.getBoundingClientRect();
      const cx = (e.touches[0].clientX + e.touches[1].clientX) / 2 - rect.left;
      const cy = (e.touches[0].clientY + e.touches[1].clientY) / 2 - rect.top;
      const factor = dist / lastPinchDist;
      const newScale = Math.max(fitScale * 0.5, Math.min(scale * factor, 15));

      tx = cx - (cx - tx) * (newScale / scale);
      ty = cy - (cy - ty) * (newScale / scale);
      scale = newScale;
      applyTransform();
    }
    lastPinchDist = dist;
  }, { passive: false });

  viewport.addEventListener('touchend', () => {
    lastPinchDist = 0;
  }, { passive: true });

  // ─── Close handlers ───
  closeBtn.addEventListener('click', close);
  overlay.addEventListener('click', (e) => {
    // Only close if clicking the overlay background itself, not the viewport
    if (e.target === overlay) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  // ─── Event delegation for opening ───
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    // Case 1: <img data-zoom-src="...">
    if (target.matches('[data-zoom-src]')) {
      const el = target as HTMLImageElement;
      open(el.dataset.zoomSrc!, el.dataset.zoomCaption || el.alt || '');
      return;
    }

    // Case 2: <a data-lightbox> or child of one
    const link = target.closest('[data-lightbox]') as HTMLAnchorElement | null;
    if (link) {
      e.preventDefault();
      const inner = link.querySelector('img');
      const captionText = link.dataset.lightboxCaption || inner?.alt || '';
      open(link.href, captionText);
    }
  });
</script>
