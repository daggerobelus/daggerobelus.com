---
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/method/', label: 'Methodology' },
  { href: '/contact/', label: 'Contact' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="border-b border-ink/10">
  <div class="max-w-content mx-auto px-6 md:px-10 py-5 md:py-6 flex flex-col md:flex-row items-center md:justify-between gap-4 md:gap-8">
    <a href="/" class="shrink-0 flex flex-col items-center gap-[3px] hover:opacity-80 transition-opacity" aria-label="Dagger Obelus — Early Modern Studies home">
      <img src="/brand/logo.png" alt="" class="h-10 md:h-11 w-auto" />
      <span class="logo-tagline">Early Modern Studies</span>
    </a>

    <nav class="w-full md:w-auto flex items-center justify-center flex-wrap gap-x-3 gap-y-2 md:gap-x-8">
      {navItems.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'font-ui nav-item no-underline transition-colors',
            isActive(href) ? 'text-ink' : 'text-ink/55 hover:text-ink'
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  header a {
    text-decoration: none !important;
  }
</style>
