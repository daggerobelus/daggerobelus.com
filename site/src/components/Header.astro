---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/method/', label: 'Methodology' },
  { href: '/contact/', label: 'Contact' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class:list={['border-b border-ink/10', compact && 'is-compact']} style="background-color: #F2EDE0;">
  <div class:list={[
    'mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center md:justify-between gap-4 md:gap-8',
    compact ? 'max-w-none py-3 md:py-4' : 'max-w-content py-5 md:py-6',
  ]}>
    <a href="/" class="shrink-0 flex flex-col items-center gap-[3px] hover:opacity-80 transition-opacity" aria-label="Dagger Obelus — Early Modern Studies home">
      <img
        src="/brand/logo.png"
        alt=""
        class:list={['w-auto', compact ? 'h-7 md:h-8' : 'h-10 md:h-11']}
      />
      <span class="logo-tagline">Early Modern Studies</span>
    </a>

    <nav class="w-full md:w-auto flex items-center justify-center flex-wrap gap-x-3 gap-y-2 md:gap-x-6">
      {navItems.map(({ href, label }, i) => (
        <>
          {i > 0 && <span class="nav-sep" aria-hidden="true">•</span>}
          <a
            href={href}
            class:list={[
              'font-ui nav-item no-underline transition-colors',
              isActive(href) ? 'text-ink' : 'text-ink/55 hover:text-ink'
            ]}
          >
            {label}
          </a>
        </>
      ))}
    </nav>
  </div>
</header>

<style>
  header a {
    text-decoration: none !important;
  }
  /* Dark gold dot separator between nav items */
  .nav-sep {
    color: color-mix(in srgb, var(--color-gold) 85%, var(--color-ink));
    font-size: 0.5rem;
    line-height: 1;
    user-select: none;
    transform: translateY(-0.05em);
  }
  /* Nav text sits ~1.5px above the base font-ui size for slightly more weight */
  .nav-item {
    font-size: 0.8rem;
  }
  /* Compact tagline shrinks proportionally with the wordmark */
  header.is-compact :global(.logo-tagline) {
    font-size: 0.48rem;
  }
  @media (min-width: 768px) {
    header.is-compact :global(.logo-tagline) {
      font-size: 0.52rem;
    }
  }
</style>
