---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark.png';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const year = new Date().getFullYear();

const navItems = [
  { href: '/about/#the-author', label: 'Contact' },
  { href: '/about/', label: 'About' },
  { href: '/method/', label: 'Methodology' },
];
---

<footer
  class="border-t mt-16"
  style="border-top-color: color-mix(in srgb, var(--color-gold) 30%, transparent);"
>
  <div class:list={[
    'mx-auto px-6 md:px-10 py-10',
    compact ? 'max-w-none' : 'max-w-content',
  ]}>
    <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-8">

      <a href="/" class="flex items-center justify-center md:justify-start hover:opacity-80 transition-opacity" aria-label="Dagger Obelus — home">
        <Image src={mark} alt="" width={40} densities={[2]} loading="eager" class="h-10 w-10" />
      </a>

      <nav class="flex items-center justify-center gap-6 md:gap-8">
        {navItems.map(({ href, label }) => (
          <a href={href} class="font-ui text-ink/55 hover:text-ink transition-colors no-underline">
            {label}
          </a>
        ))}
      </nav>

      <div class="flex items-center justify-center md:justify-end">
        <span class="font-ui text-ink/40">&copy; {year}</span>
      </div>

    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none !important;
  }
</style>
