---
/**
 * Stacking failure visualization: Run 13 variants (13a–d) vs Run 4 baseline.
 * All variants stacked multiple interventions and scored ~63–65% CER,
 * dramatically worse than the 9.30% baseline. Brumwich MS160 page 10.
 *
 * Design: Two bars — baseline vs. a single combined range for all variants.
 * The gap between 9% and 63% tells the story instantly.
 */
interface Props {
  caption?: string;
}
const { caption = 'Best CER from each Run 13 variant on Brumwich MS160 — every combination of interventions performed dramatically worse than the simple alphabet-first baseline' } = Astro.props;
---

<figure class="stacking-failure not-prose my-12">
  <div id="stacking-failure-chart" class="w-full"></div>
  <figcaption class="text-sm text-ink/60 font-mono mt-4 text-center max-w-2xl mx-auto">
    {caption}
  </figcaption>
</figure>

<script>
  import * as d3 from 'd3';

  const baseline = {
    label: 'Alphabet-first only',
    sublabel: 'Run 4 — one intervention',
    cer: 9.30,
    color: '#2878b5',
    detail: 'Single intervention — just study the hand first, then transcribe',
    scores: [
      { agent: 'Single agent', cer: 9.30 },
    ],
  };

  const combined = {
    label: 'Every combination tried',
    sublabel: '4 variants, 20 agents total',
    cerBest: 62.55,
    cerWorst: 64.57,
    cerDisplay: '62.55\u201364.57',
    color: '#c44040',
    detail: 'Error protocol, generation effect, alphabet-first, and split alphabet — alone and combined',
    variants: [
      { name: 'Error protocol only', cer: 64.57, agents: [70.84, 72.34, 70.31, 64.57, 74.45] },
      { name: '+ generation effect', cer: 62.55, agents: [68.50, 62.55, 64.08, 67.41, 65.01] },
      { name: '+ alphabet-first', cer: 63.97, agents: [72.14, 77.51, 64.73, 71.97, 63.97] },
      { name: '+ split alphabet', cer: 62.94, agents: [68.95, 62.94, 63.19, 67.94, 66.97] },
    ],
  };

  function render() {
    const container = document.getElementById('stacking-failure-chart');
    if (!container) return;
    container.innerHTML = '';

    const containerWidth = container.clientWidth;
    if (containerWidth <= 0) return;
    const isMobile = containerWidth < 500;

    const maxWidth = Math.min(containerWidth, 700);
    const labelColWidth = isMobile ? 90 : 200;
    const barAreaWidth = maxWidth - labelColWidth - 100;
    const rowHeight = 60;
    const rowGap = 16;
    const topPad = 20;
    const totalHeight = topPad + rowHeight * 2 + rowGap + 20;

    const svg = d3.select('#stacking-failure-chart')
      .append('svg')
      .attr('width', maxWidth)
      .attr('height', totalHeight);

    const barScale = d3.scaleLinear()
      .domain([0, 80])
      .range([0, barAreaWidth]);

    const barX = labelColWidth;
    const barH = 34;

    // Tooltip
    const tooltip = d3.select('#stacking-failure-chart')
      .append('div')
      .style('position', 'absolute')
      .style('background', '#fff7f4')
      .style('border', '1px solid #121212')
      .style('padding', '10px 14px')
      .style('font-size', '12px')
      .style('font-family', 'SF Mono, Monaco, monospace')
      .style('pointer-events', 'none')
      .style('opacity', 0)
      .style('box-shadow', '2px 2px 0 rgba(0,0,0,0.08)')
      .style('z-index', 10)
      .style('max-width', '320px')
      .style('line-height', '1.6');

    // Helper: create interactive bar
    function addBar(x, y, w, h, color, onHover, onOut) {
      const barFill = svg.append('rect')
        .attr('x', x).attr('y', y)
        .attr('width', w).attr('height', h)
        .attr('fill', color).attr('opacity', 0.2).attr('rx', 4);

      const barStroke = svg.append('rect')
        .attr('x', x).attr('y', y)
        .attr('width', w).attr('height', h)
        .attr('fill', 'none').attr('stroke', color)
        .attr('stroke-width', 2).attr('opacity', 0.5).attr('rx', 4);

      svg.append('rect')
        .attr('x', x).attr('y', y - 4)
        .attr('width', Math.max(w + 100, 200))
        .attr('height', h + 8)
        .attr('fill', 'transparent')
        .attr('cursor', 'pointer')
        .on('mouseover', function() {
          barFill.attr('opacity', 0.35);
          barStroke.attr('opacity', 0.8);
          onHover();
        })
        .on('mousemove', function(event) {
          const chartRect = container.getBoundingClientRect();
          tooltip
            .style('left', (event.clientX - chartRect.left + 15) + 'px')
            .style('top', (event.clientY - chartRect.top - 10) + 'px');
        })
        .on('mouseout', function() {
          barFill.attr('opacity', 0.2);
          barStroke.attr('opacity', 0.5);
          onOut();
        });
    }

    // --- Baseline row ---
    const baseRowY = topPad;
    const baseBarY = baseRowY + (rowHeight - barH) / 2;

    svg.append('text')
      .attr('x', isMobile ? 8 : barX - 16)
      .attr('y', baseBarY + 12)
      .attr('text-anchor', isMobile ? 'start' : 'end')
      .attr('font-size', '14px')
      .attr('font-family', 'Georgia, serif')
      .attr('fill', baseline.color)
      .attr('font-weight', '600')
      .text(baseline.label);

    if (!isMobile) {
      svg.append('text')
        .attr('x', barX - 16)
        .attr('y', baseBarY + 28)
        .attr('text-anchor', 'end')
        .attr('font-size', '11px')
        .attr('font-family', 'Georgia, serif')
        .attr('fill', baseline.color)
        .attr('opacity', 0.6)
        .text(baseline.sublabel);
    }

    const baseBarW = Math.max(barScale(baseline.cer), 4);
    addBar(barX, baseBarY, baseBarW, barH, baseline.color,
      () => {
        tooltip.html(`
          <strong style="color:${baseline.color}">${baseline.label}</strong><br>
          <span style="color:#666;font-size:11px">${baseline.detail}</span><br>
          <hr style="border:none;border-top:1px solid #ddd;margin:4px 0">
          Best CER: ${baseline.cer}%
        `).style('opacity', 1);
      },
      () => tooltip.style('opacity', 0)
    );

    svg.append('text')
      .attr('x', barX + baseBarW + 12)
      .attr('y', baseBarY + barH / 2 + 1)
      .attr('dominant-baseline', 'middle')
      .attr('font-size', '22px')
      .attr('font-family', 'SF Mono, Monaco, monospace')
      .attr('fill', baseline.color)
      .attr('font-weight', '700')
      .text(`${baseline.cer}%`);

    // --- Combined variants row ---
    const combRowY = topPad + rowHeight + rowGap;
    const combBarY = combRowY + (rowHeight - barH) / 2;

    svg.append('text')
      .attr('x', isMobile ? 8 : barX - 16)
      .attr('y', combBarY + 12)
      .attr('text-anchor', isMobile ? 'start' : 'end')
      .attr('font-size', '14px')
      .attr('font-family', 'Georgia, serif')
      .attr('fill', combined.color)
      .attr('font-weight', '600')
      .text(combined.label);

    if (!isMobile) {
      svg.append('text')
        .attr('x', barX - 16)
        .attr('y', combBarY + 28)
        .attr('text-anchor', 'end')
        .attr('font-size', '11px')
        .attr('font-family', 'Georgia, serif')
        .attr('fill', combined.color)
        .attr('opacity', 0.6)
        .text(combined.sublabel);
    }

    // Bar spans from best to worst variant CER
    const combBarStart = barScale(combined.cerBest);
    const combBarEnd = barScale(combined.cerWorst);
    const combBarW = Math.max(combBarEnd, 4);

    // Variant breakdown for tooltip
    const variantLines = combined.variants
      .map(v => `${v.name}: ${v.cer}% (best of 5)`)
      .join('<br>');

    addBar(barX, combBarY, combBarW, barH, combined.color,
      () => {
        tooltip.html(`
          <strong style="color:${combined.color}">${combined.label}</strong><br>
          <span style="color:#666;font-size:11px">${combined.detail}</span><br>
          <hr style="border:none;border-top:1px solid #ddd;margin:4px 0">
          ${variantLines}
        `).style('opacity', 1);
      },
      () => tooltip.style('opacity', 0)
    );

    svg.append('text')
      .attr('x', barX + combBarW + 12)
      .attr('y', combBarY + barH / 2 - 4)
      .attr('dominant-baseline', 'middle')
      .attr('font-size', '22px')
      .attr('font-family', 'SF Mono, Monaco, monospace')
      .attr('fill', combined.color)
      .attr('font-weight', '700')
      .text(`${combined.cerDisplay}%`);

    // Subtext showing what was combined
    svg.append('text')
      .attr('x', barX + combBarW + 12)
      .attr('y', combBarY + barH / 2 + 14)
      .attr('font-size', '12px')
      .attr('font-family', 'SF Mono, Monaco, monospace')
      .attr('fill', combined.color)
      .attr('opacity', 0.7)
      .text('across all 4 variants');
  }

  render();
  window.addEventListener('resize', render);
</script>

<style>
  .stacking-failure {
    position: relative;
  }
</style>
