---
/**
 * Heat map showing how error categories that actually changed across Henslow runs.
 * Focuses on the three categories with meaningful movement.
 */
interface Props {
  caption?: string;
}
const { caption = 'Henslow MS688 — the error categories that moved across runs' } = Astro.props;
---

<figure class="error-breakdown not-prose my-12">
  <div id="error-chart" class="w-full"></div>
  <figcaption class="text-sm text-ink/60 font-mono mt-4 text-center max-w-2xl mx-auto">
    {caption}
  </figcaption>
</figure>

<script>
  import * as d3 from 'd3';

  const runs = [
    { id: 4, label: 'Run 4', method: 'Alphabet-first', cer: '4.96%' },
    { id: 5, label: 'Run 5', method: 'Review agent', cer: '5.38%' },
    { id: 6, label: 'Run 6', method: 'Vocabulary', cer: '3.80%' },
    { id: 7, label: 'Run 7', method: 'Visual charts', cer: '7.59%' },
    { id: 8, label: 'Run 8', method: 'Triple-pass', cer: '4.54%' },
  ];

  const categories = [
    { name: 'Letterform', counts: [7, 15, 12, 15, 11] },
    { name: 'Double letter', counts: [8, 4, 5, 10, 8] },
    { name: 'u/v convention', counts: [3, 5, 3, 0, 3] },
  ];

  // Baseline is Run 4 (index 0)
  const baselineIndex = 0;

  function render() {
    const container = document.getElementById('error-chart');
    if (!container) return;
    container.innerHTML = '';

    const containerWidth = container.clientWidth;
    if (containerWidth <= 0) return;
    const width = Math.min(containerWidth, 850);

    const margin = { top: 10, right: 30, bottom: 0, left: 130 };
    const cellWidth = (width - margin.left - margin.right) / runs.length;
    const cellHeight = 64;
    const headerHeight = 60;
    const chartHeight = headerHeight + categories.length * cellHeight;

    const svg = d3.select('#error-chart')
      .append('svg')
      .attr('width', width)
      .attr('height', chartHeight + margin.top + margin.bottom)
      .append('g')
      .attr('transform', `translate(${margin.left},${margin.top})`);

    // Color scale — diverging from baseline
    // Lower than baseline = green, same = neutral, higher = red
    const maxCount = d3.max(categories, d => d3.max(d.counts));
    const colorScale = d3.scaleLinear()
      .domain([0, 8, 15])
      .range(['#f0f7f1', '#fff7f4', '#c44040'])
      .clamp(true);

    // Tooltip
    const tooltip = d3.select('#error-chart')
      .append('div')
      .style('position', 'absolute')
      .style('background', '#fff7f4')
      .style('border', '1px solid #121212')
      .style('padding', '8px 12px')
      .style('font-size', '12px')
      .style('font-family', 'SF Mono, Monaco, monospace')
      .style('pointer-events', 'none')
      .style('opacity', 0)
      .style('z-index', 10)
      .style('max-width', '220px')
      .style('line-height', '1.5');

    // Column headers
    runs.forEach((run, j) => {
      const cx = j * cellWidth + cellWidth / 2;

      svg.append('text')
        .attr('x', cx)
        .attr('y', 12)
        .attr('text-anchor', 'middle')
        .attr('font-size', '12px')
        .attr('font-weight', '600')
        .attr('font-family', 'Georgia, serif')
        .attr('fill', '#121212')
        .text(run.label);

      svg.append('text')
        .attr('x', cx)
        .attr('y', 26)
        .attr('text-anchor', 'middle')
        .attr('font-size', '11px')
        .attr('font-family', 'Georgia, serif')
        .attr('fill', '#888')
        .text(run.method);

      svg.append('text')
        .attr('x', cx)
        .attr('y', 40)
        .attr('text-anchor', 'middle')
        .attr('font-size', '10px')
        .attr('font-family', 'SF Mono, Monaco, monospace')
        .attr('fill', run.cer === '3.80%' ? '#2d8a4e' : run.cer === '7.59%' ? '#c44040' : '#888')
        .attr('font-weight', (run.cer === '3.80%' || run.cer === '7.59%') ? '600' : '400')
        .text(run.cer);
    });

    // Separator line
    svg.append('line')
      .attr('x1', -margin.left + 10)
      .attr('x2', runs.length * cellWidth)
      .attr('y1', headerHeight - 8)
      .attr('y2', headerHeight - 8)
      .attr('stroke', 'rgba(18,18,18,0.1)');

    // Heat map cells
    categories.forEach((cat, i) => {
      const y = headerHeight + i * cellHeight;
      const baseline = cat.counts[baselineIndex];

      // Row label
      svg.append('text')
        .attr('x', -12)
        .attr('y', y + cellHeight / 2 + 4)
        .attr('text-anchor', 'end')
        .attr('font-size', '13px')
        .attr('font-family', 'Georgia, serif')
        .attr('fill', '#121212')
        .text(cat.name);

      // Cells
      cat.counts.forEach((count, j) => {
        const x = j * cellWidth;
        const diff = count - baseline;

        // Cell background
        svg.append('rect')
          .attr('x', x + 4)
          .attr('y', y + 4)
          .attr('width', cellWidth - 8)
          .attr('height', cellHeight - 8)
          .attr('fill', colorScale(count))
          .attr('stroke', j === baselineIndex ? '#121212' : 'rgba(18,18,18,0.08)')
          .attr('stroke-width', j === baselineIndex ? 1.5 : 1)
          .attr('stroke-dasharray', j === baselineIndex ? '4,2' : 'none')
          .attr('rx', 3)
          .attr('cursor', 'pointer')
          .on('mouseover', function(event) {
            d3.select(this).attr('opacity', 0.85);
            const diffText = j === baselineIndex
              ? '(baseline)'
              : diff > 0 ? `+${diff} from baseline` : diff < 0 ? `${diff} from baseline` : 'no change';
            tooltip.html(`<strong>${cat.name}</strong><br>${count} errors<br><span style="color:${diff > 0 ? '#c44040' : diff < 0 ? '#2d8a4e' : '#888'}">${diffText}</span>`)
              .style('opacity', 1);
          })
          .on('mousemove', function(event) {
            const chartRect = container.getBoundingClientRect();
            tooltip
              .style('left', (event.clientX - chartRect.left + 12) + 'px')
              .style('top', (event.clientY - chartRect.top - 40) + 'px');
          })
          .on('mouseout', function() {
            d3.select(this).attr('opacity', 1);
            tooltip.style('opacity', 0);
          });

        // Count number
        svg.append('text')
          .attr('x', x + cellWidth / 2)
          .attr('y', y + cellHeight / 2 + 1)
          .attr('text-anchor', 'middle')
          .attr('dominant-baseline', 'middle')
          .attr('font-size', '18px')
          .attr('font-weight', '600')
          .attr('font-family', 'SF Mono, Monaco, monospace')
          .attr('fill', count >= 12 ? '#fff' : '#121212')
          .attr('pointer-events', 'none')
          .text(count);

        // Change indicator (skip baseline)
        if (j !== baselineIndex && diff !== 0) {
          svg.append('text')
            .attr('x', x + cellWidth / 2)
            .attr('y', y + cellHeight / 2 + 18)
            .attr('text-anchor', 'middle')
            .attr('font-size', '10px')
            .attr('font-family', 'SF Mono, Monaco, monospace')
            .attr('fill', count >= 12 ? 'rgba(255,255,255,0.8)' : diff > 0 ? '#c44040' : '#2d8a4e')
            .attr('pointer-events', 'none')
            .text(diff > 0 ? `+${diff}` : `${diff}`);
        }
      });

      // Row separator
      if (i < categories.length - 1) {
        svg.append('line')
          .attr('x1', 0)
          .attr('x2', runs.length * cellWidth)
          .attr('y1', y + cellHeight)
          .attr('y2', y + cellHeight)
          .attr('stroke', 'rgba(18,18,18,0.05)');
      }
    });
  }

  render();
  window.addEventListener('resize', render);
</script>

<style>
  .error-breakdown {
    position: relative;
  }
</style>
