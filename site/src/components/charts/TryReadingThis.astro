---
/**
 * Interactive "try reading this yourself" exercise.
 * Shows a cropped manuscript image and lets readers attempt to read it
 * before revealing the answer. Readers can type their own transcription
 * and get a CER score to compare against the AI.
 */
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="try-reading not-prose my-12">
  <div id="try-reading-widget" class="max-w-3xl mx-auto"></div>
  {caption && (
    <figcaption class="text-sm text-ink/60 font-mono mt-4 text-center max-w-2xl mx-auto">
      {caption}
    </figcaption>
  )}
</figure>

<script>
  // Simple Levenshtein distance for CER calculation
  function levenshtein(a, b) {
    const m = a.length, n = b.length;
    const dp = Array.from({ length: m + 1 }, () => new Array(n + 1).fill(0));
    for (let i = 0; i <= m; i++) dp[i][0] = i;
    for (let j = 0; j <= n; j++) dp[0][j] = j;
    for (let i = 1; i <= m; i++) {
      for (let j = 1; j <= n; j++) {
        dp[i][j] = a[i - 1] === b[j - 1]
          ? dp[i - 1][j - 1]
          : 1 + Math.min(dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1]);
      }
    }
    return dp[m][n];
  }

  function computeCER(reference, hypothesis) {
    const refChars = reference.length;
    if (refChars === 0) return 0;
    const dist = levenshtein(reference, hypothesis);
    return (dist / refChars) * 100;
  }

  const exercises = [
    {
      id: 'henslow',
      title: 'Henslow MS688',
      difficulty: 'Approachable',
      difficultyColor: '#2d8a4e',
      image: '/projects/teaching-machines-to-read/images/manuscripts/henslow-crop-pyles.jpg',
      fullImage: '/projects/teaching-machines-to-read/images/manuscripts/henslow-ms688-p12.jpg',
      prompt: 'This is from a 1620s recipe book written in English secretary hand — the standard handwriting of early modern England. Can you read it?',
      tryPrompt: 'Try transcribing the first two lines after the title (starting with "Take"):',
      targetLines: 'Take one handefull of mollet leaues, and wrappe them in a Colewort\nleafe, and rake them in the Imbers vntill they bee well rosted',
      answer: [
        '· · · · For the pyles · · · ·',
        '',
        'Take one handefull of mollet leaues, and wrappe them in a Colewort',
        'leafe, and rake them in the Imbers vntill they bee well rosted',
        'then take them, and put awaye the Coleworte leafe, and grinde',
      ],
      hints: [
        { label: 'Long s', explanation: 'The tall letter that looks like an "f" without the crossbar is actually a long s (ſ). "pyles" = piles, "leaues" = leaves.' },
        { label: 'Secretary d', explanation: 'The letter that loops back to the left is a secretary d — it looks nothing like a modern d. See "handefull" and "and".' },
        { label: 'Imbers', explanation: '"Imbers" means embers — you\'re wrapping mallow leaves in a cabbage leaf and roasting them in the coals. This is a recipe for treating hemorrhoids.' },
      ],
      aiResult: 'The AI read this at 3.80% CER in its best run — nearly as accurate as the leading commercial tool (Transkribus, ~3%).',
      aiCER: 3.80,
    },
    {
      id: 'jane-jackson',
      title: 'Jane Jackson MS373',
      difficulty: 'Very hard',
      difficultyColor: '#c44040',
      image: '/projects/teaching-machines-to-read/images/manuscripts/jane-jackson-crop-top.jpg',
      fullImage: '/projects/teaching-machines-to-read/images/manuscripts/jane-jackson-ms373-p20.jpg',
      prompt: 'This is from a different recipe book, written in a more compact hand. Even this relatively clean section is challenging. Can you make out any words?',
      tryPrompt: 'Try transcribing the first line (starting with "the"):',
      targetLines: 'the harth and lay it to the navell as hot as you can indure',
      answer: [
        'the harth and lay it to the navell as hot as you can indure',
        'it This use shifting it once in xxiiij howers 3 or 4 dayes together',
        'For the pilling of the face',
        '',
        'Take Turpendine of venice and wash it with red rose water till you',
        'haue taken away the smell of the turpentine then take the',
        'marrow of a stagg or for want thereof deere suitt and melt them',
        'altogether but lett them not seeth put into it vergins wax more',
        'then the qantity of the suett and so stirr it still till it be could',
        'For freckles on the face',
      ],
      hints: [
        { label: 'Pilling', explanation: '"Pilling" means peeling — this recipe treats peeling or flaking skin on the face. The treatment uses turpentine of Venice (a tree resin), rose water, deer suet, and virgin\'s wax.' },
        { label: 'Abbreviations', explanation: 'Notice "ye" (the), "yt" (that) — these use the old letter thorn (þ) which looks like a y in this hand.' },
        { label: 'Water damage', explanation: 'Scroll down in the full image to see why the AI scored 46.85% CER — the bottom third is consumed by water stains, making the text physically impossible to read.' },
      ],
      aiResult: 'The AI scored 46.85% CER at best on this page. In its first attempt, it hallucinated entirely different recipes — inventing wound treatments and cough cures that don\'t appear anywhere in the manuscript.',
      aiCER: 46.85,
    },
  ];

  function render() {
    const container = document.getElementById('try-reading-widget');
    if (!container) return;
    container.innerHTML = '';

    exercises.forEach((ex, idx) => {
      const section = document.createElement('div');
      section.style.cssText = `margin-bottom: ${idx < exercises.length - 1 ? '56px' : '0'};`;

      // Header
      const header = document.createElement('div');
      header.style.cssText = 'display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px;';

      const title = document.createElement('h3');
      title.style.cssText = 'font-family: Georgia, serif; font-size: 20px; margin: 0; color: #121212;';
      title.textContent = ex.title;

      const badge = document.createElement('span');
      badge.style.cssText = `
        font-family: 'SF Mono', Monaco, monospace; font-size: 11px;
        padding: 2px 8px; border-radius: 10px;
        background: ${ex.difficultyColor}18; color: ${ex.difficultyColor}; font-weight: 600;
      `;
      badge.textContent = ex.difficulty;

      header.appendChild(title);
      header.appendChild(badge);

      // Prompt
      const prompt = document.createElement('p');
      prompt.style.cssText = 'font-family: Georgia, serif; font-size: 14px; color: #555; margin: 0 0 16px 0; line-height: 1.6;';
      prompt.textContent = ex.prompt;

      // Image
      const imgWrap = document.createElement('div');
      imgWrap.style.cssText = 'border: 1px solid rgba(18,18,18,0.15); border-radius: 6px; overflow: hidden; margin-bottom: 16px;';

      const img = document.createElement('img');
      img.src = ex.image;
      img.alt = `${ex.title} manuscript section`;
      img.style.cssText = 'width: 100%; height: auto; display: block;';
      img.loading = 'lazy';
      imgWrap.appendChild(img);

      // "Try it yourself" section
      const trySection = document.createElement('div');
      trySection.style.cssText = 'margin-bottom: 16px;';

      const tryLabel = document.createElement('label');
      tryLabel.style.cssText = `
        font-family: Georgia, serif; font-size: 14px; color: #121212;
        display: block; margin-bottom: 8px;
      `;
      tryLabel.textContent = ex.tryPrompt;

      const textarea = document.createElement('textarea');
      textarea.style.cssText = `
        width: 100%; box-sizing: border-box;
        font-family: 'SF Mono', Monaco, monospace; font-size: 13px;
        line-height: 1.8; padding: 12px 16px;
        border: 1px solid rgba(18,18,18,0.2); border-radius: 4px;
        background: #fff; color: #121212; resize: vertical;
        min-height: 70px;
      `;
      textarea.placeholder = 'Type what you can read...';
      textarea.setAttribute('rows', '3');

      // Restore from session storage
      const storageKey = `try-reading-${ex.id}`;
      const saved = sessionStorage.getItem(storageKey);
      if (saved) textarea.value = saved;

      // Save on input
      textarea.addEventListener('input', () => {
        sessionStorage.setItem(storageKey, textarea.value);
      });

      trySection.appendChild(tryLabel);
      trySection.appendChild(textarea);

      // Reveal button
      const revealBtn = document.createElement('button');
      revealBtn.style.cssText = `
        font-family: 'SF Mono', Monaco, monospace; font-size: 13px;
        padding: 10px 24px; border: 2px solid #121212; background: none;
        color: #121212; cursor: pointer; border-radius: 4px;
        transition: all 0.2s; display: block; margin: 0 auto 16px auto;
      `;
      revealBtn.textContent = 'Reveal transcription';
      revealBtn.addEventListener('mouseover', () => {
        revealBtn.style.background = '#121212';
        revealBtn.style.color = '#fff7f4';
      });
      revealBtn.addEventListener('mouseout', () => {
        revealBtn.style.background = 'none';
        revealBtn.style.color = '#121212';
      });

      // Answer panel (hidden initially)
      const answerPanel = document.createElement('div');
      answerPanel.style.cssText = 'display: none;';

      // Score panel (shows reader's CER if they typed something)
      const scorePanel = document.createElement('div');
      scorePanel.style.cssText = 'display: none; margin-bottom: 16px;';

      // Transcription text
      const textBlock = document.createElement('div');
      textBlock.style.cssText = `
        font-family: 'SF Mono', Monaco, monospace; font-size: 13px;
        line-height: 1.8; padding: 16px 20px;
        background: rgba(18,18,18,0.03);
        border-left: 3px solid ${ex.difficultyColor};
        border-radius: 0 4px 4px 0;
        white-space: pre-wrap; color: #121212;
        margin-bottom: 16px; cursor: pointer;
      `;
      textBlock.textContent = ex.answer.join('\n');

      // Hints
      const hintsWrap = document.createElement('div');
      hintsWrap.style.cssText = 'margin-bottom: 12px;';

      ex.hints.forEach(hint => {
        const hintEl = document.createElement('details');
        hintEl.style.cssText = 'margin-bottom: 8px; border: 1px solid rgba(18,18,18,0.08); border-radius: 4px; overflow: hidden;';

        const summary = document.createElement('summary');
        summary.style.cssText = `
          font-family: 'SF Mono', Monaco, monospace; font-size: 13px;
          padding: 8px 14px; cursor: pointer; color: ${ex.difficultyColor};
          font-weight: 600; user-select: none;
        `;
        summary.textContent = hint.label;

        const detail = document.createElement('div');
        detail.style.cssText = 'font-family: Georgia, serif; font-size: 14px; color: #555; padding: 0 14px 10px 14px; line-height: 1.6;';
        detail.textContent = hint.explanation;

        hintEl.appendChild(summary);
        hintEl.appendChild(detail);
        hintsWrap.appendChild(hintEl);
      });

      // AI result note
      const aiNote = document.createElement('p');
      aiNote.style.cssText = `
        font-family: 'SF Mono', Monaco, monospace; font-size: 12px;
        color: #888; margin: 12px 0 0 0; line-height: 1.5;
        padding: 10px 14px; background: rgba(18,18,18,0.02);
        border-radius: 4px;
      `;
      aiNote.textContent = ex.aiResult;

      answerPanel.appendChild(scorePanel);
      answerPanel.appendChild(textBlock);
      answerPanel.appendChild(hintsWrap);
      answerPanel.appendChild(aiNote);

      // Toggle reveal
      revealBtn.addEventListener('click', () => {
        answerPanel.style.display = 'block';
        revealBtn.style.display = 'none';
        trySection.style.display = 'none';

        // Calculate and show score if they typed something
        const attempt = textarea.value.trim();
        if (attempt.length > 0) {
          const cer = computeCER(ex.targetLines, attempt);
          const cerRounded = Math.round(cer * 100) / 100;

          let comparison = '';
          if (cerRounded < ex.aiCER) {
            comparison = `You beat the AI (${ex.aiCER}% CER).`;
          } else if (cerRounded === ex.aiCER) {
            comparison = `You tied with the AI (${ex.aiCER}% CER).`;
          } else {
            comparison = `The AI scored ${ex.aiCER}% CER on this passage.`;
          }

          let grade = '';
          let gradeColor = '';
          if (cerRounded < 5) { grade = 'Excellent'; gradeColor = '#2d8a4e'; }
          else if (cerRounded < 15) { grade = 'Good'; gradeColor = '#2878b5'; }
          else if (cerRounded < 30) { grade = 'Decent'; gradeColor = '#d4712a'; }
          else if (cerRounded < 60) { grade = 'Tough going'; gradeColor = '#c44040'; }
          else { grade = 'This is hard!'; gradeColor = '#c44040'; }

          scorePanel.style.display = 'block';
          scorePanel.style.cssText = `
            margin-bottom: 16px; padding: 14px 18px;
            background: ${gradeColor}08; border: 1px solid ${gradeColor}30;
            border-radius: 6px;
          `;
          scorePanel.innerHTML = `
            <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px;">
              <span style="font-family: 'SF Mono', Monaco, monospace; font-size: 22px; font-weight: 700; color: ${gradeColor};">${cerRounded}% CER</span>
              <span style="font-family: Georgia, serif; font-size: 14px; color: ${gradeColor};">${grade}</span>
            </div>
            <div style="font-family: Georgia, serif; font-size: 13px; color: #555; line-height: 1.5;">
              ${comparison}
              CER (Character Error Rate) measures the percentage of characters that differ from the reference transcription.
            </div>
            <div style="margin-top: 10px; font-family: 'SF Mono', Monaco, monospace; font-size: 11px; color: #888;">
              Your attempt: <span style="color: #555;">${attempt.length > 80 ? attempt.slice(0, 80) + '...' : attempt}</span>
            </div>
          `;
        }
      });

      // Click transcription to hide and restore
      textBlock.addEventListener('click', () => {
        answerPanel.style.display = 'none';
        revealBtn.style.display = 'block';
        trySection.style.display = 'block';
      });

      section.appendChild(header);
      section.appendChild(prompt);
      section.appendChild(imgWrap);
      section.appendChild(trySection);
      section.appendChild(revealBtn);
      section.appendChild(answerPanel);
      container.appendChild(section);
    });
  }

  render();
</script>

<style>
  .try-reading details summary::-webkit-details-marker {
    color: #888;
  }
  .try-reading details[open] summary {
    border-bottom: 1px solid rgba(18,18,18,0.06);
    margin-bottom: 4px;
  }
  .try-reading textarea:focus {
    outline: none;
    border-color: #121212;
  }
</style>
